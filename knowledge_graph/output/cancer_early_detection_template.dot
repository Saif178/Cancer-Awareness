digraph CancerAwarenessTemplate {
graph [layout=neato, overlap=false, splines=true, bgcolor="white", pad=0.35, outputorder=edgesfirst, label="CANCER EARLY DETECTION KNOWLEDGE GRAPH\nFrom Screening to Better Outcomes", labelloc=t, labeljust=c, fontsize=18, fontname="Arial"];
node [fontname="Arial", fontsize=10, margin="0.10,0.06", pin=true];
edge [fontname="Arial", fontsize=8, arrowsize=0.65, penwidth=1.3];
n_early_detection_of_cancer [pos="0,0!", shape=ellipse, width=2.6, height=1.5, style="filled", fillcolor="#F4EEFF", color="#512DA8", penwidth=2.2, fontcolor="#2F1B69", label=< <B>Early Detection</B><BR/><B>of Cancer</B><BR/><BR/>Improves treatment outcomes, survival<BR/>rates and quality of life >];
n_better_outcomes [pos="720,-230!", shape=box, width=2.35, style="rounded,filled", fillcolor="#EEF8EE", color="#2E7D32", penwidth=1.8, fontcolor="#1B5E20", label=< <B>BETTER OUTCOMES</B><BR/><BR/>• Early treatment<BR/>• Higher survival rates<BR/>• Improved quality of life<BR/>• Reduced healthcare costs >];
n_module_blood_biomarkers [pos="-520,230!", shape=box, width=3.15, height=0.72, style="rounded,filled", fillcolor="#FFFFFF", color="#2E7D32", penwidth=2.0, fontcolor="#2E7D32", label=< <B>1. Blood Tests &amp; Biomarkers [E1]</B><BR/><FONT POINT-SIZE="9">Detect cancer using biomarkers in body fluids</FONT> >];
n_module_mammography [pos="520,230!", shape=box, width=3.15, height=0.72, style="rounded,filled", fillcolor="#FFFFFF", color="#1565C0", penwidth=2.0, fontcolor="#1565C0", label=< <B>2. Mammography for Breast Cancer [E2]</B><BR/><FONT POINT-SIZE="9">Breast imaging used for early signs and screening</FONT> >];
n_module_prostate [pos="-520,10!", shape=box, width=3.15, height=0.72, style="rounded,filled", fillcolor="#FFFFFF", color="#512DA8", penwidth=2.0, fontcolor="#512DA8", label=< <B>3. Prostate Cancer Detection [E3]</B><BR/><FONT POINT-SIZE="9">Screening and detection for prostate cancer</FONT> >];
n_module_colorectal [pos="520,10!", shape=box, width=3.15, height=0.72, style="rounded,filled", fillcolor="#FFFFFF", color="#EF6C00", penwidth=2.0, fontcolor="#EF6C00", label=< <B>4. Colorectal Cancer Screening [E4]</B><BR/><FONT POINT-SIZE="9">Recommended screening methods for colorectal cancer</FONT> >];
n_module_diagnostics [pos="0,-230!", shape=box, width=3.15, height=0.72, style="rounded,filled", fillcolor="#FFFFFF", color="#00838F", penwidth=2.0, fontcolor="#00838F", label=< <B>5. General Diagnostic Tests [E5]</B><BR/><FONT POINT-SIZE="9">Tests used to confirm diagnosis and determine extent</FONT> >];
n_module_blood_biomarkers__sample_types [pos="-650,145!", shape=box, width=1.95, height=0.88, style="rounded,filled", fillcolor="#FAFCFE", color="#2E7D32", penwidth=1.15, fontcolor="#2E7D32", label=< <B>Sample Types</B><BR/>• Blood<BR/>• Urine<BR/>• Saliva >];
n_module_blood_biomarkers__key_features [pos="-520,145!", shape=box, width=1.95, height=0.88, style="rounded,filled", fillcolor="#FAFCFE", color="#2E7D32", penwidth=1.15, fontcolor="#2E7D32", label=< <B>Key Features</B><BR/>• Detects biomarkers<BR/>• Rapid testing potential<BR/>• Non-invasive testing potential >];
n_module_blood_biomarkers__benefits [pos="-390,145!", shape=box, width=1.95, height=0.88, style="rounded,filled", fillcolor="#FAFCFE", color="#2E7D32", penwidth=1.15, fontcolor="#2E7D32", label=< <B>Benefits</B><BR/>• Accessible<BR/>• Efficient<BR/>• Early detection >];
n_module_mammography__method [pos="390,145!", shape=box, width=1.95, height=0.88, style="rounded,filled", fillcolor="#FAFCFE", color="#1565C0", penwidth=1.15, fontcolor="#1565C0", label=< <B>Method</B><BR/>• Mammography (2-D)<BR/>• 3-D mammography / tomosynthesis >];
n_module_mammography__detects [pos="520,145!", shape=box, width=1.95, height=0.88, style="rounded,filled", fillcolor="#FAFCFE", color="#1565C0", penwidth=1.15, fontcolor="#1565C0", label=< <B>Detects</B><BR/>• Microcalcifications<BR/>• Small tumors<BR/>• Early signs >];
n_module_mammography__benefits [pos="650,145!", shape=box, width=1.95, height=0.88, style="rounded,filled", fillcolor="#FAFCFE", color="#1565C0", penwidth=1.15, fontcolor="#1565C0", label=< <B>Benefits</B><BR/>• Higher detection rate<BR/>• Better for dense breast tissue >];
n_module_prostate__who [pos="-650,-80!", shape=box, width=1.95, height=0.88, style="rounded,filled", fillcolor="#FAFCFE", color="#512DA8", penwidth=1.15, fontcolor="#512DA8", label=< <B>Who</B><BR/>• Men over 50 / higher risk<BR/>• Family history<BR/>• Genetic risk >];
n_module_prostate__screening_methods [pos="-520,-80!", shape=box, width=1.95, height=0.88, style="rounded,filled", fillcolor="#FAFCFE", color="#512DA8", penwidth=1.15, fontcolor="#512DA8", label=< <B>Screening Methods</B><BR/>• PSA blood test<BR/>• Digital rectal exam<BR/>• MRI / imaging >];
n_module_prostate__benefits [pos="-390,-80!", shape=box, width=1.95, height=0.88, style="rounded,filled", fillcolor="#FAFCFE", color="#512DA8", penwidth=1.15, fontcolor="#512DA8", label=< <B>Benefits</B><BR/>• Detects early<BR/>• Supports treatment planning<BR/>• Monitors progression >];
n_module_colorectal__screening_methods [pos="390,-80!", shape=box, width=1.95, height=0.88, style="rounded,filled", fillcolor="#FAFCFE", color="#EF6C00", penwidth=1.15, fontcolor="#EF6C00", label=< <B>Screening Methods</B><BR/>• Colonoscopy<BR/>• Blood tests (FIT)<BR/>• DNA stool tests<BR/>• CT colonography >];
n_module_colorectal__who_when [pos="520,-80!", shape=box, width=1.95, height=0.88, style="rounded,filled", fillcolor="#FAFCFE", color="#EF6C00", penwidth=1.15, fontcolor="#EF6C00", label=< <B>Who &amp; When</B><BR/>• Age / risk-based screening<BR/>• Higher risk: earlier and more frequent >];
n_module_colorectal__benefits [pos="650,-80!", shape=box, width=1.95, height=0.88, style="rounded,filled", fillcolor="#FAFCFE", color="#EF6C00", penwidth=1.15, fontcolor="#EF6C00", label=< <B>Benefits</B><BR/>• Detects polyps &amp; early cancer<BR/>• Supports prevention >];
n_module_diagnostics__imaging_tests [pos="-400,-330!", shape=box, width=1.95, height=0.88, style="rounded,filled", fillcolor="#FAFCFE", color="#00838F", penwidth=1.15, fontcolor="#00838F", label=< <B>Imaging Tests</B><BR/>• Ultrasound<BR/>• X-rays<BR/>• CT scan<BR/>• MRI<BR/>• PET scan >];
n_module_diagnostics__laboratory_tests [pos="-200,-330!", shape=box, width=1.95, height=0.88, style="rounded,filled", fillcolor="#FAFCFE", color="#00838F", penwidth=1.15, fontcolor="#00838F", label=< <B>Laboratory Tests</B><BR/>• Blood tests<BR/>• Urine tests<BR/>• Tumor markers >];
n_module_diagnostics__tissue_sampling [pos="0,-330!", shape=box, width=1.95, height=0.88, style="rounded,filled", fillcolor="#FAFCFE", color="#00838F", penwidth=1.15, fontcolor="#00838F", label=< <B>Tissue Sampling</B><BR/>• Biopsy<BR/>• Fine needle aspiration<BR/>• Endoscopic biopsy >];
n_module_diagnostics__purpose [pos="200,-330!", shape=box, width=1.95, height=0.88, style="rounded,filled", fillcolor="#FAFCFE", color="#00838F", penwidth=1.15, fontcolor="#00838F", label=< <B>Purpose</B><BR/>• Confirm diagnosis<BR/>• Determine cancer type<BR/>• Assess stage<BR/>• Guide treatment >];
n_module_diagnostics__outcome [pos="400,-330!", shape=box, width=1.95, height=0.88, style="rounded,filled", fillcolor="#FAFCFE", color="#00838F", penwidth=1.15, fontcolor="#00838F", label=< <B>Outcome</B><BR/>• Accurate diagnosis<BR/>• Treatment planning<BR/>• Monitor response >];
